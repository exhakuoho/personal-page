---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('awards')).sort((a, b) => b.data.date.localeCompare(a.data.date));

const kindMeta: Record<string, { zh: string; cls: string }> = {
  Award: { zh: '得獎', cls: 'text-volt-400 border-volt-500/40' },
  News: { zh: '新聞', cls: 'text-elec-400 border-elec-500/40' },
  Event: { zh: '活動', cls: 'text-emerald-400 border-emerald-500/40' },
  Publication: { zh: '發表', cls: 'text-amber-400 border-amber-500/40' },
};
---

<BaseLayout title="得獎與新聞｜白空 Haku" description="白空 Haku 的得獎紀錄、媒體報導、論文發表與活動紀錄時間軸。">
  <section class="relative overflow-hidden border-b hairline">
    <div class="absolute -top-24 left-1/4 w-96 h-96 rounded-full bg-elec-500/15 blur-[100px]"></div>
    <div class="mx-auto max-w-6xl px-5 py-20 relative">
      <p class="eyebrow rise rise-1 mb-4">Awards & News</p>
      <h1 class="rise rise-2 font-display text-4xl md:text-6xl font-bold mb-6">得獎與新聞</h1>
      <p class="rise rise-3 text-lg text-muted max-w-2xl leading-relaxed">
        競賽成績、媒體報導、論文發表與活動足跡,按時間排列。
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-16">
    <div class="relative pl-8 border-l hairline space-y-10">
      {items.map((item) => {
        const meta = kindMeta[item.data.kind];
        return (
          <div class="reveal relative">
            <span class="absolute -left-[37px] top-1.5 w-3 h-3 rounded-full bg-gradient-to-r from-elec-500 to-volt-500 ring-4" style="--tw-ring-color: rgb(var(--bg));"></span>
            <div class="card p-6">
              <div class="flex items-center gap-3 mb-3 flex-wrap">
                <span class={`chip ${meta.cls}`}>{meta.zh} {item.data.kind}</span>
                <span class="font-mono text-xs text-muted">{item.data.date}</span>
                {item.data.placeholder && <span class="font-mono text-[11px] text-amber-500/80">⚠ 待補資料</span>}
              </div>
              <h2 class="font-bold text-lg mb-2">{item.data.title}</h2>
              <p class="text-sm text-muted leading-relaxed">{item.data.summary}</p>
              {item.data.link && (
                <a href={item.data.link} target="_blank" rel="noopener" class="font-mono text-xs text-elec-400 mt-3 inline-block">
                  查看連結 →
                </a>
              )}
            </div>
          </div>
        );
      })}
    </div>

    <p class="reveal text-center text-sm text-muted font-mono mt-14">
      // 帶「⚠ 待補資料」標記的項目為 placeholder,實際名稱、日期與連結陸續補上
    </p>
  </section>
</BaseLayout>
