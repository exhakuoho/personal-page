---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { expertiseList } from '../data/expertise';
import { getCollection } from 'astro:content';

const awards = (await getCollection('awards'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 4);

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const kindColor: Record<string, string> = {
  Award: 'text-volt-400 border-volt-500/40',
  News: 'text-elec-400 border-elec-500/40',
  Event: 'text-emerald-400 border-emerald-500/40',
  Publication: 'text-amber-400 border-amber-500/40',
};

const brands = [
  ['DesignJarvis', '設計 × AIoT × 智慧場域', 'ACTIVE', 'https://designjarvis.com'],
  ['Factory Jarvis', '智慧工廠能源/碳排監測', 'ACTIVE', 'https://factoryjarvis.designjarvis.com/'],
  ['FlexPro', '試量產評估系統', 'DEV', 'https://flexpro.designjarvis.com'],
  ['406LAB', '技術實驗 / ESPHome / 感測', 'ACTIVE', 'https://406lab.designjarvis.com'],
  ['LOOK 教育', 'STEAM 課程與科技營隊', 'ACTIVE', '/links'],
  ['Formosa31', '鐘錶門市 / 維修工藝', 'ACTIVE', '/links'],
  ['白空科研', 'R&D / 設計加工接案實體', 'ACTIVE', '/about'],
];
---

<BaseLayout>
  <Hero />

  <!-- 六大專長模組 -->
  <section id="expertise" class="mx-auto max-w-6xl px-5 py-16">
    <div class="reveal mb-8 flex items-end justify-between flex-wrap gap-3 border-b hairline pb-4">
      <div>
        <p class="idx mb-1">SEC.01 — EXPERTISE MODULES</p>
        <h2 class="font-display text-2xl md:text-3xl font-bold">六大專長領域</h2>
      </div>
      <p class="font-mono text-[11px] text-muted">06 MODULES / 各自獨立能力頁</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {expertiseList.map((e, i) => (
        <a href={`/expertise/${e.slug}`} class="card hud reveal p-5 group block" style={`transition-delay:${i * 50}ms`}>
          <div class="flex items-center justify-between mb-3">
            <span class="idx">MOD.{String(i + 1).padStart(2, '0')}</span>
            <span class="text-xl">{e.icon}</span>
          </div>
          <p class="font-mono text-[10px] text-muted tracking-widest uppercase mb-0.5">{e.en}</p>
          <h3 class="font-display text-lg font-bold mb-2 group-hover:text-elec-400 transition-colors">{e.zh}</h3>
          <p class="text-[13px] text-muted leading-relaxed mb-3">{e.intro}</p>
          <div class="flex flex-wrap gap-1 mb-3">
            {e.items.slice(0, 5).map((item) => (
              <span class="font-mono text-[10px] text-elec-500 dark:text-elec-400 bg-elec-500/10 rounded px-1.5 py-0.5">{item}</span>
            ))}
            {e.items.length > 5 && (
              <span class="font-mono text-[10px] text-muted px-1.5 py-0.5">+{e.items.length - 5}</span>
            )}
          </div>
          <div class="flex items-center justify-between border-t hairline pt-2.5">
            <span class="font-mono text-[10px] text-muted">{e.items.length} CAPABILITIES</span>
            <span class="font-mono text-[11px] text-elec-400 group-hover:translate-x-1 inline-block transition-transform">OPEN →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 專案索引(密集列表) -->
  <section class="border-t hairline">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <div class="reveal mb-8 flex items-end justify-between flex-wrap gap-3 border-b hairline pb-4">
        <div>
          <p class="idx mb-1">SEC.02 — PROJECT INDEX</p>
          <h2 class="font-display text-2xl md:text-3xl font-bold">專案索引</h2>
        </div>
        <a href="/projects" class="btn-ghost text-xs">完整專案庫 →</a>
      </div>

      <div class="reveal overflow-x-auto">
        <table class="w-full text-sm min-w-[640px]">
          <thead>
            <tr class="font-mono text-[10px] uppercase tracking-widest text-muted border-b hairline">
              <th class="text-left py-2 pr-4 font-medium">ID</th>
              <th class="text-left py-2 pr-4 font-medium">Project</th>
              <th class="text-left py-2 pr-4 font-medium">Type</th>
              <th class="text-left py-2 pr-4 font-medium">Stack</th>
              <th class="text-right py-2 font-medium">Status</th>
            </tr>
          </thead>
          <tbody>
            {projects.map((p, i) => (
              <tr class="border-b hairline hover:bg-elec-500/5 transition-colors">
                <td class="py-3 pr-4 font-mono text-[11px] text-muted">PRJ-{String(i + 1).padStart(3, '0')}</td>
                <td class="py-3 pr-4">
                  <span class="font-bold">{p.data.title}</span>
                  {p.data.featured && <span class="font-mono text-[10px] grad-text ml-2">★</span>}
                </td>
                <td class="py-3 pr-4 font-mono text-[11px] text-muted">{p.data.tags[0]}</td>
                <td class="py-3 pr-4 font-mono text-[11px] text-elec-500 dark:text-elec-400">{p.data.tech.slice(0, 3).join(' · ')}</td>
                <td class="py-3 text-right"><span class="chip text-[10px]">{p.data.status}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 得獎與新聞 Highlights -->
  <section class="border-t hairline">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <div class="reveal mb-8 flex items-end justify-between flex-wrap gap-3 border-b hairline pb-4">
        <div>
          <p class="idx mb-1">SEC.03 — HIGHLIGHTS</p>
          <h2 class="font-display text-2xl md:text-3xl font-bold">得獎與新聞</h2>
        </div>
        <a href="/awards-news" class="btn-ghost text-xs">完整時間軸 →</a>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        {awards.map((a, i) => (
          <div class="card reveal p-5" style={`transition-delay:${i * 50}ms`}>
            <div class="flex items-center gap-2.5 mb-2.5">
              <span class={`chip text-[10px] ${kindColor[a.data.kind] ?? ''}`}>{a.data.kind}</span>
              <span class="font-mono text-[11px] text-muted">{a.data.date}</span>
              {a.data.placeholder && <span class="font-mono text-[10px] text-amber-500/80">⚠ 待補</span>}
            </div>
            <h3 class="font-bold mb-1.5">{a.data.title}</h3>
            <p class="text-[13px] text-muted leading-relaxed">{a.data.summary}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 品牌矩陣狀態表 -->
  <section class="border-t hairline">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <div class="reveal mb-8 border-b hairline pb-4">
        <p class="idx mb-1">SEC.04 — BRAND MATRIX</p>
        <h2 class="font-display text-2xl md:text-3xl font-bold">品牌矩陣</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {brands.map(([name, desc, status, href], i) => (
          <a href={href} class="card reveal p-4 group" style={`transition-delay:${i * 40}ms`}>
            <div class="flex items-center justify-between mb-1.5">
              <span class="font-mono font-bold text-sm">{name}</span>
              <span class={`font-mono text-[9px] px-1.5 py-0.5 rounded ${status === 'ACTIVE' ? 'text-emerald-400 bg-emerald-500/10' : 'text-amber-400 bg-amber-500/10'}`}>{status}</span>
            </div>
            <p class="font-mono text-[11px] text-muted">{desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
