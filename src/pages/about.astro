---
import BaseLayout from '../layouts/BaseLayout.astro';

const identities = [
  { role: '設計公司 CEO', org: 'DesignJarvis' },
  { role: '傳統加工公司 COO', org: '精密 CNC / 傳統加工' },
  { role: '教育機構技術顧問', org: 'STEAM 教育導入' },
  { role: '模具工程研究生', org: '國立高雄科技大學' },
];
---

<BaseLayout title="關於我｜白空 Haku" description="曾唯誠(白空 Haku)——機械設計 × AIoT × STEAM 教育 × 精密製造的跨領域整合者。">
  <section class="relative overflow-hidden border-b hairline">
    <div class="absolute -top-24 left-1/3 w-96 h-96 rounded-full bg-elec-500/15 blur-[100px]"></div>
    <div class="mx-auto max-w-6xl px-5 py-20 relative">
      <p class="eyebrow rise rise-1 mb-4">About</p>
      <h1 class="rise rise-2 font-display text-4xl md:text-6xl font-bold mb-6">
        關於<span class="grad-text">白空</span>
      </h1>
      <p class="rise rise-3 text-lg text-muted max-w-2xl leading-relaxed">
        曾唯誠 Tseng Weicheng,常用名稱白空 / Haku。<br />
        把技術轉化成能被理解、能被使用、也能產生實際價值的解決方案。
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 space-y-16">
    <!-- 身份 -->
    <div class="reveal">
      <h2 class="font-display text-2xl font-bold mb-6">目前身份</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {identities.map((i) => (
          <div class="card p-5">
            <p class="font-bold mb-1">{i.role}</p>
            <p class="text-sm text-muted font-mono">{i.org}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- 核心定位 -->
    <div class="reveal card p-8 md:p-12 relative overflow-hidden">
      <div class="absolute -right-16 -bottom-16 w-64 h-64 rounded-full bg-volt-600/10 blur-[80px]"></div>
      <p class="eyebrow mb-4">Core Positioning</p>
      <p class="font-display text-2xl md:text-3xl font-bold leading-snug mb-6">
        機械設計 <span class="grad-text">×</span> AIoT <span class="grad-text">×</span> STEAM 教育 <span class="grad-text">×</span> 精密製造
      </p>
      <p class="text-muted leading-relaxed max-w-3xl">
        我的經歷橫跨精密加工、鐘錶零件設計、AIoT 系統開發、STEAM 教育推廣與創業專案整合。從硬體設計、機構開發、感測器應用,到課程教材、競賽專案與智慧製造概念——我專注於將機械設計、電控系統、3D 列印、CNC 加工與人工智慧應用,整合成可實際落地的產品、教具與教育方案。
      </p>
    </div>

    <!-- 背景 -->
    <div class="grid md:grid-cols-3 gap-5">
      {[
        {
          t: '學術與研究',
          d: '國立高雄科技大學模具工程相關研究所。研究方向包含 FDM 3D 列印生命週期評估、智慧製造與碳排監測,並協助學術論文撰寫與研討會發表。',
        },
        {
          t: '創業與顧問',
          d: '經營 DesignJarvis 品牌與白空科研接案實體,承接設計加工與 AIoT 專案;同時擔任教育機構技術顧問,協助課程與技術導入。',
        },
        {
          t: '教學與教育',
          d: '主理教育品牌 LOOK,規劃 LEGO、3D 列印、自走車、人形機器人課程與科技營隊,把工程知識轉譯成孩子能動手理解的體驗。',
        },
      ].map((b, i) => (
        <div class="card reveal p-6" style={`transition-delay:${i * 60}ms`}>
          <h3 class="font-display font-bold text-lg mb-3">{b.t}</h3>
          <p class="text-sm text-muted leading-relaxed">{b.d}</p>
        </div>
      ))}
    </div>

    <!-- 品牌關係 -->
    <div class="reveal">
      <h2 class="font-display text-2xl font-bold mb-6">品牌與實體</h2>
      <div class="space-y-4">
        {[
          ['DesignJarvis', '設計、AIoT、智慧場域與產品整合品牌,是所有產品線的門面。'],
          ['白空科研', 'DesignJarvis 旗下的 R&D / 接案實體,承接設計與加工案件。'],
          ['LOOK', 'STEAM 教育品牌(前身 FAYMI),涵蓋課程、教具與科技營隊。'],
          ['Formosa31', '鐘錶品牌——門市經營、鐘錶維修與工藝,官方授權、本地經營。'],
        ].map(([name, desc]) => (
          <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 border-b hairline pb-4">
            <span class="font-mono font-bold w-40 shrink-0">{name}</span>
            <span class="text-sm text-muted">{desc}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
